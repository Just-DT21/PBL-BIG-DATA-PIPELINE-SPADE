+    flex-direction: column; overflow-y: auto;
+    transform: translateX(-100%);
+    transition: transform 240ms ease;
+  }
+  .app.is-drawer-open .sidebar { transform: translateX(0); }
+  /* Inside the drawer the full labels are always shown, whatever the rail state. */
+  .app.is-collapsed .sidebar .brand { flex-direction: row; align-items: center; gap: .7rem; }
+  .app.is-collapsed .brand-text { display: block; }
+  .app.is-collapsed .nav-item { justify-content: flex-start; gap: .6rem; padding: .55rem .65rem; }
