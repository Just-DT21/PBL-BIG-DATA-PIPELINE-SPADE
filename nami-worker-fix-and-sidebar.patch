+/* ------------------------------------------------- collapsible sidebar */
+/* The rail/drawer state lives on #app-shell ("is-collapsed"), so the grid, the
+   sidebar and the main column all read from one place. */
+.sidebar .brand-text { min-width: 0; }
+.nav-label { white-space: nowrap; overflow: hidden; transition: opacity 160ms ease; }
+.sidebar-foot #sign-out { display: flex; align-items: center; justify-content: center; gap: .5rem; }
+
+.icon-btn {
+  display: inline-flex; align-items: center; justify-content: center;
+  width: 28px; height: 28px; flex: none; padding: 0;
+  background: var(--navy-700); color: var(--text-dim);
+  border: 1px solid var(--line); border-radius: var(--radius-sm);
+  font-size: .95rem; line-height: 1; cursor: pointer;
+}
+.icon-btn:hover { background: var(--navy-600); color: var(--text); border-color: var(--blue-500); }
+.icon-btn:focus-visible { outline: 2px solid var(--blue-400); outline-offset: 2px; }
+
+.sidebar-toggle { margin-left: auto; }
+.topbar-left { display: flex; align-items: flex-start; gap: .7rem; min-width: 0; }
+
+/* Collapsed desktop rail: the diamond and every icon stay, the text goes, and
+   nothing is left occupying empty space. */
+.app.is-collapsed .sidebar { padding: 1.1rem .45rem; gap: .9rem; }
+.app.is-collapsed .sidebar .brand { flex-direction: column; align-items: center; gap: .55rem; }
+.app.is-collapsed .brand-text { display: none; }
+.app.is-collapsed .sidebar-toggle { margin-left: 0; width: 24px; height: 24px; font-size: .78rem; }
+.app.is-collapsed .nav-item { justify-content: center; gap: 0; padding: .55rem .3rem; }
+.app.is-collapsed .nav-label { opacity: 0; width: 0; }
+.app.is-collapsed #sidebar-user { display: none; }
+.app.is-collapsed .signout-label { display: none; }
+
+.mobile-menu { display: none; }
+
+/* Scrim behind the off-canvas drawer; only ever shown on narrow screens. */
+.sidebar-scrim {
+  position: fixed; inset: 0; z-index: 55; display: none;
+  background: rgba(3, 7, 18, .62);
+  opacity: 0; visibility: hidden;
+  transition: opacity 220ms ease, visibility 220ms ease;
+}
+.app.is-drawer-open .sidebar-scrim { opacity: 1; visibility: visible; }
+
+@media (prefers-reduced-motion: reduce) {
+  .app, .sidebar, .nav-label, .sidebar-scrim { transition: none; }
+}
+
